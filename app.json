{
  "expo": {
    "name": "Daily Checklist",
    "slug": "daily-checklist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dailychecklist",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF5EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "package": "com.anonymous.dailychecklist"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-task-manager",
      [
        "expo-notifications",
        {
          "color": "#2F6B4F",
          "androidMode": "default",
          "androidCollapsedTitle": "Daily Checklist"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF5EC",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sharing",
      "expo-background-fetch",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Daily Checklist uses your location only to tell whether you're at home or the office, so it can give the right food nudge. Locations stay on your device."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Daily Checklist saves progress photos only on your device to track your body changes over time.",
          "cameraPermission": "Daily Checklist uses the camera so you can take progress photos. They stay on your device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
